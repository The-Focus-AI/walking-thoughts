#!/usr/bin/env bash
# Snapshot only tools and dependencies. Never resolve or persist credentials here.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export CI=true

step() {
  local label="$1" start=$SECONDS
  shift
  printf '\n▶ %s\n' "$label"
  "$@"
  printf '✓ %s (%ss)\n' "$label" "$((SECONDS - start))"
}

if ! command -v mise >/dev/null 2>&1; then
  step "Install mise" bash -c 'curl -fsSL https://mise.run | sh'
fi

# Supervised services and Amp use non-interactive login shells, not .bashrc.
marker='# Walking Thoughts orb toolchain'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
  "$ROOT/"*) export PATH="\$HOME/.local/share/mise/shims:\$HOME/.local/bin:\$PATH" ;;
esac
EOF
fi

step "Trust project tools" mise trust "$ROOT/mise.toml"
# mise intentionally ignores this setting in project config for security.
mise settings set unix_default_inline_shell_args 'bash -c -o errexit'
step "Install mise toolchain" mise install

# Match the Cursor bootstrap's official 1Password distribution; no sign-in.
if ! command -v op >/dev/null 2>&1; then
  case "$(uname -m)" in
    x86_64) op_arch=amd64 ;;
    aarch64) op_arch=arm64 ;;
    *) echo 'Unsupported 1Password architecture' >&2; exit 1 ;;
  esac
  if ! command -v unzip >/dev/null 2>&1; then
    step "Refresh apt metadata" sudo apt-get update -qq
    step "Install unzip" sudo apt-get install -y --no-install-recommends unzip
  fi
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  step "Download 1Password CLI" curl -fsSLo "$tmp/op.zip" \
    "https://cache.agilebits.com/dist/1P/op2/pkg/v2.32.0/op_linux_${op_arch}_v2.32.0.zip"
  unzip -q "$tmp/op.zip" op -d "$tmp"
  install -m 755 "$tmp/op" "$HOME/.local/bin/op"
fi

# Skills are versioned in Git. experimental_install rewrites them from upstream.
step "Install locked dependencies and test browser" mise run install:dependencies
printf '\nWalking Thoughts snapshot ready; credentials are configured at resume.\n'
